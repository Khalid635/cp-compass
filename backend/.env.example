# Copy to .env and fill in. Never commit a real .env.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./cpcompass.db
# For production (Neon Postgres): DATABASE_URL=postgresql+psycopg2://user:pass@host/db
CF_API_BASE=https://codeforces.com/api
ACCESS_EXPIRE_MINUTES=15
REFRESH_EXPIRE_DAYS=7
# Email verification codes go out via Resend when RESEND_API_KEY is set;
# otherwise they are written to backend/dev_outbox.log (local dev only).
RESEND_API_KEY=
MAIL_FROM=CP Compass <noreply@cpcompass.app>

# Google sign-in (OAuth client in Google Cloud Console; values live in
# the environment / Render env, never committed). Until these are set,
# GET /api/v1/auth/google answers 503. The redirect URI must match one
# registered on the OAuth client exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback
# AI Hint Ladder (Gemini Flash, server-side only). Until GEMINI_API_KEY
# is set, the hint endpoints answer 503. Hints are generated on the
# server; end users never supply their own key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
HINT_DAILY_LIMIT=10
